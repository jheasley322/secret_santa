# Copy to .env (gitignored) and fill in. Never commit real values.

# Postgres connection for the pgTAP suite (npm run test:sql), project hnnzoiuibnikrucncphu.
# Use the SESSION pooler (port 5432) or the direct connection. The runner refuses
# the transaction pooler (port 6543) because it can't hold a transaction open.
SUPABASE_DB_URL=postgresql://postgres.hnnzoiuibnikrucncphu:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Playwright e2e (npm run test:e2e). The publishable key is public by design.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_PASTE_HERE
# Two test Elf users created in Supabase -> Authentication -> Users (Auto confirm).
E2E_ELF_A_EMAIL=elf-a@secret-santa-e2e.invalid
E2E_ELF_A_PASSWORD=CHANGE_ME
E2E_ELF_B_EMAIL=elf-b@secret-santa-e2e.invalid
E2E_ELF_B_PASSWORD=CHANGE_ME
